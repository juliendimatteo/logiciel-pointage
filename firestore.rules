rules_version = '2';

// Règles Firestore de PointagePro.
//
// Deux sortes d'utilisateurs Firebase :
//   - ouvriers : session anonyme (aucun mot de passe). Ils peuvent lire la
//     liste des ouvriers, les zones et les pointages, pointer, et envoyer
//     leur position. Rien d'autre.
//   - gestionnaires : compte e-mail/mot de passe Firebase Auth, rattaché à
//     un document comptes/{uid} actif. L'administrateur (admin == true) gère
//     en plus les accès gestionnaire.
// Tout ce qui n'est pas explicitement prévu est refusé, et les documents
// doivent avoir exactement la forme écrite par l'app.
// À mettre à jour en même temps que app.js si la forme des données change.
service cloud.firestore {
  match /databases/{database}/documents {

    /* ─── Qui est connecté ─── */

    function connecte() {
      return request.auth != null;
    }

    function compteEmail() {
      return connecte() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function cheminCompte(uid) {
      return /databases/$(database)/documents/comptes/$(uid);
    }

    function gestionnaire() {
      return compteEmail()
        && exists(cheminCompte(request.auth.uid))
        && get(cheminCompte(request.auth.uid)).data.actif == true;
    }

    function administrateur() {
      return gestionnaire() && get(cheminCompte(request.auth.uid)).data.admin == true;
    }

    /* ─── Validation des valeurs ─── */

    function texte(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function texteOuVide(v, max) {
      return v is string && v.size() <= max;
    }

    function nombreOuNull(v) {
      return v == null || v is number;
    }

    function texteOuNull(v, max) {
      return v == null || texte(v, max);
    }

    // Horodatage ISO 8601 tel que produit par Date.toISOString()
    function horodatage(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$');
    }

    // Jour local AAAA-MM-JJ
    function jour(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function email(v) {
      return v is string && v.size() <= 200 && v.matches('^[^@ ]+@[^@ ]+$');
    }

    /* ─── meta/etat : indicateur « données de démo déjà créées » ─── */
    match /meta/etat {
      allow read: if connecte();
      allow create: if gestionnaire() && request.resource.data == { 'initialise': true };
    }

    /* ─── meta/administration : existe dès que le premier administrateur
           a été créé. Lisible par tous pour que l'écran de connexion sache
           s'il doit proposer la création de ce compte. ─── */
    match /meta/administration {
      allow read: if connecte();
      // Créé uniquement dans le même lot que le compte du premier administrateur
      allow create: if compteEmail()
        && request.resource.data == { 'premierAdministrateur': request.auth.uid }
        && getAfter(cheminCompte(request.auth.uid)).data.admin == true;
    }

    /* ─── ouvriers ─── */
    match /ouvriers/{id} {
      allow read: if connecte();
      allow create: if gestionnaire()
        && request.resource.data.keys().hasOnly(['nom', 'metier'])
        && texte(request.resource.data.nom, 100)
        && texte(request.resource.data.metier, 100);
      allow delete: if gestionnaire();
    }

    /* ─── zones de chantier ─── */
    function zoneValide(d) {
      return d.keys().hasOnly(['nom', 'lat', 'lng', 'rayon'])
        && texte(d.nom, 100)
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.rayon is number && d.rayon >= 10 && d.rayon <= 100000;
    }

    match /zones/{id} {
      allow read: if connecte();
      allow create, update: if gestionnaire() && zoneValide(request.resource.data);
      allow delete: if gestionnaire();
    }

    /* ─── pointages ─── */
    function pointageValide(d) {
      return d.keys().hasAll(['idOuvrier', 'type', 'lat', 'lng', 'horodatage', 'idZone', 'dansZone'])
        && d.keys().hasOnly(['idOuvrier', 'type', 'lat', 'lng', 'horodatage', 'idZone', 'dansZone',
                             'automatique', 'forcee', 'manuel', 'motifManuel', 'encodePar', 'encodeLe'])
        && texte(d.idOuvrier, 100)
        && d.type in ['entree', 'sortie']
        && nombreOuNull(d.lat)
        && nombreOuNull(d.lng)
        && horodatage(d.horodatage)
        && texteOuNull(d.idZone, 100)
        && d.dansZone is bool
        && (!('automatique' in d) || d.automatique == true)
        && (!('forcee' in d) || d.forcee == true)
        && (!('manuel' in d) || d.manuel == true)
        && (!('motifManuel' in d) || d.motifManuel in ['oubli', 'reseau', 'gps', 'autre'])
        && (!('encodePar' in d) || texte(d.encodePar, 100))
        && (!('encodeLe' in d) || horodatage(d.encodeLe));
    }

    match /pointages/{id} {
      // Lu par les ouvriers pour connaître leur statut et leur historique
      allow read: if connecte();
      // Un ouvrier pointe (ou est dépointé automatiquement) ; seule la
      // direction peut forcer une sortie ou saisir un pointage manuel.
      allow create: if pointageValide(request.resource.data)
        && (gestionnaire()
            || (connecte() && !request.resource.data.keys().hasAny(['forcee', 'manuel', 'motifManuel', 'encodePar', 'encodeLe'])));
      // Seule l'heure d'un pointage existant peut être corrigée
      allow update: if gestionnaire()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['horodatage'])
        && horodatage(request.resource.data.horodatage);
      allow delete: if gestionnaire();
    }

    /* ─── positions GPS en direct (un document par ouvrier) ─── */
    match /positions/{idOuvrier} {
      allow read: if gestionnaire();
      allow create, update: if connecte()
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'horodatage'])
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && horodatage(request.resource.data.horodatage);
      allow delete: if connecte();
    }

    /* ─── absences ─── */
    function absenceValide(d) {
      return d.keys().hasAll(['idOuvrier', 'type', 'du', 'au', 'commentaire'])
        && d.keys().hasOnly(['idOuvrier', 'type', 'du', 'au', 'commentaire',
                             'creePar', 'creeLe', 'modifiePar', 'modifieLe'])
        && texte(d.idOuvrier, 100)
        // Doit correspondre aux clés de TYPES_ABSENCE dans app.js
        && d.type in ['maladie', 'conge', 'recuperation', 'formation', 'accident',
                      'chomage_economique', 'chomage_intemperies', 'a_justifier']
        && jour(d.du) && jour(d.au) && d.du <= d.au
        && texteOuVide(d.commentaire, 1000);
    }

    match /absences/{id} {
      allow read: if gestionnaire();
      allow create: if gestionnaire()
        && absenceValide(request.resource.data)
        && texte(request.resource.data.creePar, 100)
        && horodatage(request.resource.data.creeLe);
      // L'auteur et la date de création restent figés
      allow update: if gestionnaire()
        && absenceValide(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creePar', 'creeLe'])
        && texte(request.resource.data.modifiePar, 100)
        && horodatage(request.resource.data.modifieLe);
      allow delete: if gestionnaire();
    }

    /* ─── comptes gestionnaire (identifiant du document = uid Firebase) ─── */
    match /comptes/{uid} {
      // Chacun lit son propre compte (vérification à la connexion) ;
      // l'administrateur lit la liste complète.
      allow get: if connecte() && request.auth.uid == uid;
      allow read: if administrateur();

      allow create: if
        // Nouvel accès gestionnaire créé par l'administrateur
        (administrateur()
          && request.resource.data.keys().hasOnly(['nom', 'email', 'admin', 'actif'])
          && texte(request.resource.data.nom, 100)
          && email(request.resource.data.email)
          && request.resource.data.admin == false
          && request.resource.data.actif == true)
        // Premier administrateur, sur une base neuve : uniquement pour
        // soi-même et une seule fois (meta/administration créé dans le même lot)
        || (compteEmail()
          && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/meta/administration)
          && existsAfter(/databases/$(database)/documents/meta/administration)
          && request.resource.data == { 'nom': 'Administrateur', 'email': request.auth.token.email,
                                        'admin': true, 'actif': true });

      // L'administrateur active/désactive les autres accès
      allow update: if administrateur()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actif'])
        && request.resource.data.actif is bool;

      allow delete: if administrateur() && request.auth.uid != uid;
    }
  }
}
